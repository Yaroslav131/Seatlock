# ---- runtime ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- gateway ----
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# ---- postgres (docker compose maps 5433 -> 5432) ----
DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock

# Своя схема на каждый сервис в одном и том же инстансе Postgres —
# см. docs/adr/0001. ?schema= создаёт отдельное пространство таблиц.
AUTH_DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock?schema=auth
CATALOG_DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock?schema=catalog
PAYMENT_DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock?schema=payment
NOTIFICATION_DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock?schema=notification

# ---- redis ----
REDIS_URL=redis://localhost:6380

# ---- rabbitmq ----
RABBITMQ_URL=amqp://seatlock:seatlock@localhost:5673

# ---- трейсинг (Jaeger, все сервисы) ----
# Сервисы — голые Node-процессы на хосте, а не контейнеры (см. README
# "Порты"), поэтому localhost + опубликованный порт, а не имя контейнера.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- s3 / minio (notification service) ----
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=seatlock
S3_SECRET_KEY=seatlock123
S3_BUCKET=seatlock-tickets

# ---- smtp (mailpit, notification service) ----
SMTP_HOST=localhost
SMTP_PORT=1026

# ---- auth ----
AUTH_PORT=3001
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ---- catalog ----
CATALOG_PORT=3002

# ---- booking ----
# Холды мест живут только в Redis, без своей БД — см. docs/adr/0003.
BOOKING_PORT=3003
SEAT_HOLD_TTL_SECONDS=300

# ---- payment ----
PAYMENT_PORT=3004
# fake — единственная реализация сейчас (см. apps/payment/src/providers).
# Выбор реального провайдера (Stripe недоступен из Беларуси — санкции;
# альтернатива ещё не выбрана) — отдельная будущая фаза.
PAYMENT_PROVIDER=fake

# ---- stripe (задел под будущий реальный адаптер — см. выше) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- notification ----
NOTIFICATION_PORT=3005
# Сколько писем notification обрабатывает одновременно (по умолчанию 1)
# NOTIFICATION_PREFETCH=3
