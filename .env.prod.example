# Этот файл — только шаблон. Реальный .env с настоящими секретами
# создаётся один раз прямо на сервере командой ssh и в git не попадает.

POSTGRES_PASSWORD=сгенерировать-случайный
RABBITMQ_PASSWORD=сгенерировать-случайный
JWT_ACCESS_SECRET=сгенерировать-случайный
JWT_REFRESH_SECRET=сгенерировать-случайный
MINIO_ROOT_PASSWORD=сгенерировать-случайный

# Ключ из панели Resend (Settings → API Keys), ПОСЛЕ того как домен
# seatlock.fun верифицирован там же (Domains) — без верификации домена
# письма с tickets@seatlock.fun будут отклоняться, даже с валидным
# ключом. Ключ никогда не должен проходить через чат/переписку —
# только руками прямо в этот файл на сервере.
RESEND_API_KEY=api-ключ-из-панели-resend

# Нужен Caddy для регистрации в Let's Encrypt (уведомления об истечении
# сертификата). Можно указать свою почту.
CADDY_EMAIL=you@example.com
