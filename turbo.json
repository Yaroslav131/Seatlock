{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "REDIS_URL",
        "AUTH_DATABASE_URL",
        "CATALOG_DATABASE_URL",
        "PAYMENT_DATABASE_URL",
        "NOTIFICATION_DATABASE_URL",
        "RABBITMQ_URL",
        "BOOKING_SERVICE_URL",
        "CATALOG_SERVICE_URL",
        "AUTH_SERVICE_URL",
        "PAYMENT_PROVIDER",
        "JWT_ACCESS_SECRET",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "SMTP_HOST",
        "SMTP_PORT"
      ]
    },
    "test:e2e": {
      // Не кэшируется и не имеет dependsOn/build-зависимостей — бьёт
      // по уже поднятому живому стеку (pnpm dev или CI-джоб e2e),
      // а не по артефактам сборки, так что кэшировать тут нечего.
      "cache": false,
      "env": ["E2E_BASE_URL", "E2E_GATEWAY_URL", "AUTH_DATABASE_URL", "JWT_ACCESS_SECRET"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
