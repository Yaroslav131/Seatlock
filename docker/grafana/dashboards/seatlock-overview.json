{
  "title": "SeatLock — overview",
  "uid": "seatlock-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate по сервисам",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 латентность по сервисам",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "booking: попытки занять место",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "result=\"conflict\" — гонка за место реально отбита",
      "targets": [
        {
          "expr": "sum by (result) (rate(hold_attempts_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "payment: создание заказов",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "description": "result=\"conflict\" — частичный уникальный индекс Postgres реально отклонил повторную покупку",
      "targets": [
        {
          "expr": "sum by (result) (rate(orders_created_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "payment: публикация outbox в RabbitMQ",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(outbox_publish_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "notification: обработка order.paid",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(order_paid_processed_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "notification: очередь order.paid (backlog)",
      "type": "timeseries",
      "description": "Сообщения, ещё не взятые в работу. notification обрабатывает по одному (prefetch=1): если заказы оплачиваются быстрее, чем делаются PDF, число растёт без предела.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "notification_order_paid_queue_messages",
          "legendFormat": "в очереди"
        }
      ]
    },
    {
      "id": 10,
      "title": "CPU по сервисам (1.0 = одно ядро)",
      "type": "timeseries",
      "description": "Загрузка процессора Node-процессом каждого сервиса. Значение около 1.0 — сервис упёрся в одно ядро (Node однопоточный).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(process_cpu_seconds_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "event loop lag p99 по сервисам",
      "type": "timeseries",
      "description": "Насколько event loop опаздывает с обработкой очереди. Рост — сервис не успевает (блокирующая работа, например генерация PDF).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Память (RSS) по сервисам",
      "type": "timeseries",
      "description": "Резидентная память процесса. Рост при плоской нагрузке — утечка, скачок у notification — пачка PDF в памяти.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "k6: виртуальные пользователи",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "description": "Появится только во время прогона нагрузочного теста (packages/load-test)",
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "vus"
        }
      ]
    },
    {
      "id": 8,
      "title": "k6: латентность HTTP-запросов",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "description": "Появится только во время прогона нагрузочного теста — точное имя метрики зависит от версии k6, см. packages/load-test/README.md",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
