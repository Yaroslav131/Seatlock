generator client {
  provider = "prisma-client-js"
  // auth и catalog используют одинаковую версию @prisma/client — без
  // своего output pnpm физически делит один и тот же сгенерированный
  // клиент между сервисами, и чей "prisma generate" выполнился
  // последним, тот и остаётся (см. docs/adr для деталей, если понадобится).
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

// Токен не хранится вообще — только строка-разрешение с тем же id,
// что зашит в JWT как "jti". Подлинность токена доказывает подпись,
// а эта таблица только говорит, жив ли он ещё (не отозван, не заменён).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  // Кем заменён при ротации. Если кто-то попробует повторно
  // использовать уже заменённый токен — это признак кражи,
  // и мы отзываем всю сессионную цепочку целиком.
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
