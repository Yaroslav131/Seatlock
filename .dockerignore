# Docker собирает из корня репозитория, поэтому .dockerignore должен
# лежать именно здесь, а не в apps/*/.dockerignore — иначе не сработает.
**/node_modules
**/dist
**/.turbo
**/*.tsbuildinfo
# Сгенерированный Prisma-клиент под host-платформу (Windows у нас
# локально) — если утащить его в образ, контейнер получит бинарник
# движка не под ту ОС и упадёт при старте. Каждая стадия сборки
# генерирует свой заново через RUN pnpm install.
**/src/generated
.git
.github
.vscode
.env
.env.*
!.env.example
*.log
